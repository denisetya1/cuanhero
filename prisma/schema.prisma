generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  password        String?
  phoneNumber     String?          @map("phone_number")
  status          Int              @default(0) @db.TinyInt
  role            String           @default("MEMBER")
  createdAt       DateTime         @default(now())
  emailVerified   Boolean          @map("email_verified")
  image           String?
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  accounts        Account[]
  sessions        Session[]
  tradingAccounts TradingAccount[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  password              String
  createdBy             String?   @map("created_by")
  updatedBy             String?   @map("updated_by")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  @@map("verifications")
}

model Package {
  id              Int              @id @default(autoincrement())
  code            String?          @unique
  name            String
  description     Json?            @db.Json
  features        Json?            @db.Json
  price           String
  discountPercent Int?             @map("discount_percent")
  recurringType   String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  orderNumber     Int              @default(9999) @map("order_number")
  paymentRecords  PaymentRecord[]
  tradingAccounts TradingAccount[]

  @@map("packages")
}

model ExpertAdvisor {
  id              Int              @id @default(autoincrement())
  name            String
  description     Json?            @db.Json
  image           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  codeName        String           @default("") @map("code_name")
  eaFileName      String           @default("") @map("ea_file_name")
  defaultConfig   Json?            @map("default_config") @db.Json
  isActive        Boolean          @default(true) @map("is_active")
  orderNumber     Int              @default(9999) @map("order_number")
  tradingAccounts TradingAccount[]

  @@map("expert_advisors")
}

model TradingAccount {
  id                   Int                               @id @default(autoincrement())
  accountId            String                            @unique @map("account_id")
  accountPassword      String?                           @map("account_password")
  accountServer        String?                           @map("account_server")
  accountName          String?                           @map("account_name")
  accountBalance       String?                           @map("account_balance")
  eaConfiguration      Json?                             @db.Json
  status               Int                               @default(0) @db.TinyInt
  updatedAt            DateTime                          @default(now()) @updatedAt @map("updated_at")
  autoNewsFilter       Boolean                           @default(false) @map("auto_news_filter")
  lastSync             DateTime?                         @map("last_sync")
  packageId            Int                               @map("package_id")
  eaStatus             Int                               @default(0) @map("ea_status") @db.TinyInt
  createdAt            DateTime                          @default(now()) @map("created_at")
  createdBy            String?                           @map("created_by")
  endDate              DateTime?                         @map("end_date") @db.Date
  expertAdvisorId      Int                               @map("expert_advisor_id")
  updatedBy            String?                           @map("updated_by")
  userId               String                            @map("user_id")
  currency             String?
  recurringPrice       Decimal?                          @map("recurring_price") @db.Decimal(10, 2)
  serverId             Int                               @map("server_id")
  firstActivation      Boolean                           @default(true) @map("first_activation")
  expertAdvisor        ExpertAdvisor                     @relation(fields: [expertAdvisorId], references: [id])
  package              Package                           @relation(fields: [packageId], references: [id])
  paymentRecords       PaymentRecord[]
  renewalNotifications SubscriptionRenewalNotification[]
  server               Server                            @relation(fields: [serverId], references: [id])
  user                 User                              @relation(fields: [userId], references: [id])

  @@index([expertAdvisorId], map: "trading_accounts_expert_advisor_id_fkey")
  @@index([packageId], map: "trading_accounts_package_id_fkey")
  @@index([serverId], map: "trading_accounts_serverId_fkey")
  @@index([userId], map: "trading_accounts_user_id_fkey")
  @@map("trading_accounts")
}

model SubscriptionRenewalNotification {
  id               Int            @id @default(autoincrement())
  tradingAccountId Int            @map("trading_account_id")
  endDate          DateTime       @map("end_date") @db.Date
  reminderDays     Int            @map("reminder_days")
  recipientEmail   String         @map("recipient_email")
  sentAt           DateTime?      @map("sent_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, endDate, reminderDays], map: "subscription_renewal_notifications_account_end_day_key")
  @@index([sentAt], map: "subscription_renewal_notifications_sent_at_idx")
  @@map("subscription_renewal_notifications")
}

model PaymentRecord {
  id               Int            @id @default(autoincrement())
  tradingAccountId Int            @map("trading_account_id")
  packageId        Int            @map("package_id")
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("IDR")
  paymentMethod    String         @default("QRIS_STATIC") @map("payment_method")
  type             String         @default("ACTIVATION")
  status           String         @default("APPROVED")
  previousEndDate  DateTime?      @map("previous_end_date") @db.Date
  newEndDate       DateTime?      @map("new_end_date") @db.Date
  paidAt           DateTime?      @map("paid_at")
  approvedAt       DateTime?      @map("approved_at")
  note             String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  createdBy        String?        @map("created_by")
  updatedBy        String?        @map("updated_by")
  package          Package        @relation(fields: [packageId], references: [id])
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])

  @@index([packageId], map: "payment_records_package_id_fkey")
  @@index([tradingAccountId], map: "payment_records_trading_account_id_fkey")
  @@map("payment_records")
}

model Server {
  id                  Int                  @id @default(autoincrement())
  name                String?
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  ipAddress           String               @map("ip_address")
  domain              String?              @unique
  createdAt           DateTime             @default(now()) @map("created_at")
  createdBy           String?              @map("created_by")
  updatedBy           String?              @map("updated_by")
  status              Int                  @default(0) @db.TinyInt
  orderNumber         Int                  @default(9999) @map("order_number")
  tradingAccounts     TradingAccount[]
  runtimeHealthIssues RuntimeHealthIssue[]

  @@map("servers")
}

model RuntimeHealthIssue {
  id                 Int       @id @default(autoincrement())
  serverId           Int       @map("server_id")
  accountId          String    @map("account_id")
  reason             String
  registeredServerId Int?      @map("registered_server_id")
  runtimeStatus      String    @map("runtime_status")
  isRunning          Boolean   @default(false) @map("is_running")
  isPaused           Boolean   @default(false) @map("is_paused")
  pid                Int?
  lastHeartbeatAt    DateTime? @map("last_heartbeat_at")
  firstDetectedAt    DateTime  @default(now()) @map("first_detected_at")
  lastDetectedAt     DateTime  @default(now()) @map("last_detected_at")
  detectionCount     Int       @default(1) @map("detection_count")
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  server             Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, accountId, reason], name: "serverId_accountId_reason", map: "runtime_health_issues_server_account_reason_key")
  @@index([resolvedAt, lastDetectedAt], map: "runtime_health_issues_resolved_detected_idx")
  @@index([accountId], map: "runtime_health_issues_account_id_idx")
  @@map("runtime_health_issues")
}

model AppSetting {
  id                    Int      @id @default(1)
  whatsappNumber        String   @default("") @map("whatsapp_number")
  metaTitleEn           String   @default("") @map("meta_title_en")
  metaTitleId           String   @default("") @map("meta_title_id")
  metaDescriptionEn     String   @map("meta_description_en") @db.Text
  metaDescriptionId     String   @map("meta_description_id") @db.Text
  orderMessageEn        String   @map("order_message_en") @db.Text
  orderMessageId        String   @map("order_message_id") @db.Text
  freeTrialMessageEn    String?  @map("free_trial_message_en") @db.Text
  freeTrialMessageId    String?  @map("free_trial_message_id") @db.Text
  renewalMessageEn      String   @map("renewal_message_en") @db.Text
  renewalMessageId      String   @map("renewal_message_id") @db.Text
  consultationMessageEn String   @map("consultation_message_en") @db.Text
  consultationMessageId String   @map("consultation_message_id") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy             String?  @map("created_by")
  updatedBy             String?  @map("updated_by")

  @@map("app_settings")
}

model CmsPage {
  id                Int       @id @default(autoincrement())
  slug              String    @unique
  titleEn           String    @map("title_en")
  titleId           String    @map("title_id")
  contentEn         String    @map("content_en") @db.LongText
  contentId         String    @map("content_id") @db.LongText
  metaTitleEn       String    @default("") @map("meta_title_en")
  metaTitleId       String    @default("") @map("meta_title_id")
  metaDescriptionEn String    @map("meta_description_en") @db.Text
  metaDescriptionId String    @map("meta_description_id") @db.Text
  isPublished       Boolean   @default(false) @map("is_published")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  @@index([isPublished, updatedAt], map: "cms_pages_published_updated_idx")
  @@map("cms_pages")
}
